# Copy to .env and fill in real values. Never commit .env.
#
# Anything prefixed EXPO_PUBLIC_ is inlined into the client bundle at build
# time and is therefore PUBLIC. Only publishable/anon keys belong here.

# ── Supabase ────────────────────────────────────────────────────────────────
# Project Settings -> API. The anon key is safe to ship: Row Level Security
# (supabase/migrations/*_row_level_security.sql) is what actually protects data.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── OpenAI ──────────────────────────────────────────────────────────────────
# SERVER-SIDE ONLY. Deliberately not EXPO_PUBLIC_ — this must never reach the
# client bundle. Set it as a Supabase Edge Function secret instead:
#   supabase secrets set OPENAI_API_KEY=sk-...
# It is listed here only so the full set of required configuration is visible.
OPENAI_API_KEY=sk-your-openai-key

# ── RevenueCat (subscriptions) ──────────────────────────────────────────────
# Project -> API keys. Use the public SDK keys, not the secret key.
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=appl_your_ios_sdk_key
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=goog_your_android_sdk_key

# ── OneSignal (push / retention) ────────────────────────────────────────────
EXPO_PUBLIC_ONESIGNAL_APP_ID=00000000-0000-0000-0000-000000000000

# ── Layers (growth experiments) ─────────────────────────────────────────────
EXPO_PUBLIC_LAYERS_API_KEY=your-layers-api-key
