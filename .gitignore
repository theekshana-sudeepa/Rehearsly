# local env files
# The Expo default only covers .env*.local, which would let a real .env be
# committed. This repo is public — ignore every .env except the example.
.env
.env.*
!.env.example
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Personal notes & AI agent config
CLAUDE.md
*.local.md
.claude/
